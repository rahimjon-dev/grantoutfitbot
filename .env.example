# ============================================================
# GRANT OUTFITBOT - ENVIRONMENT CONFIGURATION
# ============================================================

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# --- TELEGRAM BOT CONFIGURATION ---
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# URL of your hosted Mini App (e.g., https://your-domain.vercel.app or ngrok tunnel for local testing)
TELEGRAM_MINI_APP_URL=http://localhost:5173

# Comma-separated list of Telegram user IDs with administrative privileges
# Find your ID using @userinfobot or @raw_data_bot on Telegram
ADMIN_TELEGRAM_IDS=123456789,987654321

# Webhook configuration (Optional for production; polling is used in development)
TELEGRAM_WEBHOOK_URL=https://your-api.domain.com/api/telegram/webhook

# --- SUPABASE CONFIGURATION ---
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Anon / Public Key (Safe for client & standard authenticated queries)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service Role Secret (NEVER expose to frontend; used only in backend server & bot)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Secret for backend session tokens (if needed)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
ADMIN_SECRET_KEY=admin_secret_passphrase_for_web_access
